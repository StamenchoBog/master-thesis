results/msc/global_checkpoints/
results/msc/*.json
results/msc/resume_from.npz
results/msc/runs/*/.logger.pid

# Thesis text, bibliography, figures and tables. Written in Overleaf, kept locally only.
docs/thesis/

# Compiled thesis and the registration form
docs/*.pdf
