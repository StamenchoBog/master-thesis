# TON_IoT dataset — download from https://research.unsw.edu.au/projects/toniot-datasets
data/*.csv
data/.cache/

# Flower CLI runtime cache
.flwr/.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# OS
.DS_Store

# Claude Code assistant config/tooling — not part of the thesis or the codebase.
.claude/
CLAUDE.md

# Working notes for writing the thesis text — internal, not for distribution.
docs/thesis-notes.md

# Working doc used to draft the thesis methodology/results chapters — superseded
# by docs/thesis/sections/, kept locally only.
experiments/protocol.md

# Overleaf-paper-only tooling (figure/table generation) — not part of the experiment.
analysis/make_figures.py

# Docker
.env

# MSc experiment run outputs — measured runs are versioned via Git LFS (see
# .gitattributes); only the transient host-side scratch files stay ignored.
results/msc/global_checkpoints/
results/msc/*.json
results/msc/resume_from.npz

# Thesis figures/tables — regenerable from analysis/make_figures.py; live in Overleaf.
# The hand-written chapter text and bibliography are NOT regenerable, so they stay tracked.
# Note: ignore the *contents* (`/*`), not the directory itself — git does not descend into
# an ignored directory, so a `!` negation under `docs/thesis/` would never take effect.
docs/thesis/*
!docs/thesis/sections/
!docs/thesis/references.bib
