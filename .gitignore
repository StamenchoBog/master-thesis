# TON_IoT dataset — download from https://research.unsw.edu.au/projects/toniot-datasets
data/*.csv
data/.cache/

# Flower CLI runtime cache
.flwr/.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# OS
.DS_Store

# Claude Code assistant config/tooling — not part of the thesis or the codebase.
.claude/
CLAUDE.md

# Working notes for writing the thesis text — internal, not for distribution.
docs/thesis-notes.md

# Working doc used to draft the thesis methodology/results chapters — superseded
